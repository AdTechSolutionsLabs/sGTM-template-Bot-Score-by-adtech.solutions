// In-app / embedded browser markers. These WebViews (a) frequently freeze the
// OS token at the version they were built against, and (b) on Android report a
// Chrome/ UA without sending UA-CH. Neither is a bot signal, so both checks are
// skipped for them. Keep lowercase.
const INAPP_TOKENS = ['wv)','naver(','fban','fbav','fbios','fb_iab','instagram','line/','kakaotalk','micromessenger','snapchat','pinterest/','bytedancewebview','musical_ly','tiktok','twitter','gsa/','linkedinapp','whatsapp','telegram','daumapps','yjapp','yahoo'];

const debug = data.debug === true;
const log = (msg) => { if (debug) logToConsole('Bot Score - ' + msg); };

const isNum = (n) => getType(n) === 'number' && n === n;
const str = (s) => (getType(s) === 'string' ? s : '');
const lower = (s) => str(s).toLowerCase();
const numOr = (v, d) => { const n = makeNumber(v); return isNum(n) ? n : d; };
const header = (h) => str(getRequestHeader(h));
const lastHop = (v) => { const parts = str(v).split(','); return parts[parts.length - 1].split(' ').join(''); };

// IPv4 dotted-quad to integer. Returns -1 for anything non-v4 (IPv6 falls
// through to the header/UA signals only — see NOTES).
const ipv4ToInt = (ip) => {
  const parts = str(ip).split('.');
  if (parts.length !== 4) return -1;
  let n = 0; let ok = true;
  parts.forEach((part) => {
    const o = makeNumber(part);
    if (!isNum(o) || o < 0 || o > 255 || part === '') ok = false; else n = n * 256 + o;
  });
  return ok ? n : -1;
};

// RFC1918 / loopback / link-local / CGNAT — never a meaningful "client IP".
const isPrivateV4 = (n) => {
  if (n < 0) return true;
  if (n >= 167772160 && n <= 184549375) return true;   // 10.0.0.0/8
  if (n >= 2886729728 && n <= 2887778303) return true; // 172.16.0.0/12
  if (n >= 3232235520 && n <= 3232301055) return true; // 192.168.0.0/16
  if (n >= 2130706432 && n <= 2147483647) return true; // 127.0.0.0/8
  if (n >= 2851995648 && n <= 2852061183) return true; // 169.254.0.0/16
  if (n >= 1681915904 && n <= 1686110207) return true; // 100.64.0.0/10 (CGNAT)
  return false;
};

// Client IP: ONLY the configured edge header (which the CDN overwrites), else
// the socket peer. Never ip_override, never X-Forwarded-For — both are
// client-settable. If the header carries a comma list, the last entry is the
// one appended by the proxy nearest to us and therefore the most trustworthy.
const trustedIpHeader = lower(str(data.trustedIpHeader)).split(' ').join('');
const edgeIp = trustedIpHeader ? lastHop(header(trustedIpHeader)) : '';
const socketIp = str(getRemoteAddress());
const clientIp = edgeIp || socketIp;
const ipInt = ipv4ToInt(clientIp);
const edgeIpInt = ipv4ToInt(edgeIp);

// Binary search the sorted [start,end] ranges. No bitwise ops in the sandbox,
// so IP math is plain arithmetic (max 2^32 is within Number's safe range).
const inRanges = (n, ranges) => {
  if (n < 0) return false;
  let lo = 0; let hi = ranges.length - 1; let found = false;
  while (lo <= hi && !found) {
    const mid = Math.floor((lo + hi) / 2); const r = ranges[mid];
    if (n < r[0]) hi = mid - 1; else if (n > r[1]) lo = mid + 1; else found = true;
  }
  return found;
};

const containsAny = (hay, needles) => {
  let hit = false; needles.forEach((m) => { if (hay.indexOf(m) !== -1) hit = true; }); return hit;
};

const AI_CRAWLER_UAS = ['gptbot','oai-searchbot','chatgpt-user','claudebot','anthropic-ai','perplexitybot','ccbot','bytespider','amazonbot','google-extended','googlebot','applebot','meta-externalagent'];
const AUTOMATION_UAS = ['headlesschrome','headless','phantomjs','puppeteer','playwright','selenium','webdriver','python-requests','python-urllib','aiohttp','go-http-client','curl/','wget/','okhttp','node-fetch','axios/','java/','libwww','scrapy','httpclient','httpx'];

// Traffic-seller / referral-spam domains. These services advertise themselves
// in page_referrer (their bots do real page loads, often from residential
// proxies our IP ranges can't catch), so a match is near-certain bot traffic.
// Suffix-matched: 'grets.store' also catches 'news.grets.store'. Extend via
// the "Extra spam referrer domains" field.
const SPAM_REFERRER_DOMAINS = ['trafficheap.cc','sparktraffic.com','babylontraffic.com','simpletraffic.co','trafficbot.life','bot-traffic.icu','grets.store','garold.store','razas.site','ofer.bar','semalt.com','darodar.com','buttons-for-website.com','best-seo-offer.com','100dollars-seo.com','free-share-buttons.com','free-social-buttons.com','floating-share-buttons.com','event-tracking.com','get-free-traffic-now.com'];

// UA from request header, falling back to the GA4 client's event user_agent.
let uaRaw = header('user-agent');
if (!uaRaw) uaRaw = str(getEventData('user_agent'));
const ua = uaRaw.toLowerCase();

const outputMode = str(data.outputMode) || 'score';
const threshold = numOr(data.threshold, 70);

let diag = '';
const finish = (raw, reasons) => {
  let s = raw; if (s > 100) s = 100; if (s < 0) s = 0;
  log('score=' + s + ' reasons=[' + reasons.join(',') + '] ip=' + clientIp);
  if (outputMode === 'diagnostics') return diag || (reasons.length ? reasons.join(',') : 'clean');
  if (outputMode === 'reasons') return reasons.length ? reasons.join(',') : 'clean';
  if (outputMode === 'classification') return s >= threshold ? 'bot' : (s > 0 ? 'suspect' : 'human');
  if (outputMode === 'boolean') return s >= threshold;
  return makeInteger(s);
};

// Verified AI crawler -> whitelist (score 0) unless the user opts into blocking.
// "Verified" = UA claims a known crawler AND the IP is in that crawler's
// published range, so a spoofed "GPTBot" UA from a random host is NOT trusted.
const claimsAiCrawler = containsAny(ua, AI_CRAWLER_UAS);
const verifiedAiCrawler = claimsAiCrawler && inRanges(ipInt, AI_CRAWLER_RANGES);
if (verifiedAiCrawler && data.blockAiCrawlers !== true) return finish(0, ['verified-ai-crawler-allowed']);

let score = 0; const reasons = [];
const add = (w, why) => { score = score + w; reasons.push(why); };

if (verifiedAiCrawler && data.blockAiCrawlers === true) add(W_DATACENTER, 'ai-crawler-blocked');

const isDatacenter = inRanges(ipInt, DATACENTER_RANGES);
if (isDatacenter) add(W_DATACENTER, 'datacenter-ip');

// ---------------------------------------------------------------------------
// ip_override spoof. The GA4 client populates ip_override from the request
// (X-Forwarded-For first hop or a client-sent _uip) and the GA4 tag forwards it
// to Google as the geolocation IP. If it disagrees with what the edge says the
// client IP is, the client is lying about where it is — the exact vector used
// to make an EU scraper appear as thousands of "Australian" users. Only
// evaluated when the edge header is present, both values are public IPv4, and
// ip_override is not simply the socket peer (some clients set that).
// ---------------------------------------------------------------------------
const ipo = str(getEventData('ip_override'));
const ipoInt = ipv4ToInt(ipo);
if (edgeIpInt >= 0 && ipoInt >= 0 && !isPrivateV4(edgeIpInt) && !isPrivateV4(ipoInt)
    && ipoInt !== edgeIpInt && ipo !== socketIp) {
  add(W_IP_OVERRIDE_MISMATCH, 'ip-override-mismatch');
}

if (!ua) add(W_HEADLESS, 'empty-ua');
else if (containsAny(ua, AUTOMATION_UAS)) add(W_HEADLESS, 'automation-ua');
if (claimsAiCrawler && !verifiedAiCrawler) add(W_HEADLESS, 'unverified-ai-crawler-ua');

// Malformed platform section: a space right before the first ")", e.g.
// "(Linux; Android 14; SM-S908U Build/UP1A.231005.007; )". That is what is left
// when "wv" is cut out of a WebView UA. Calibration: one scraper rotating ~40
// such UAs produced 176k one-page "users" in 3.5 months with 0 purchases, while
// 163 real users (5 purchases) shared the shape — so it corroborates (40), it
// does not decide.
const uaFirstClose = uaRaw.indexOf(')');
if (uaFirstClose > 0 && uaRaw.substring(uaFirstClose - 1, uaFirstClose) === ' ') add(W_UA_MALFORMED, 'ua-malformed');

// Screen size: 0x0 / 1x1 is a headless renderer or a scripted payload.
const sr = lower(str(getEventData('screen_resolution'))).split(' ').join('');
const srParts = sr.split('x');
const srW = srParts.length === 2 ? makeNumber(srParts[0]) : 0;
const srH = srParts.length === 2 ? makeNumber(srParts[1]) : 0;
const srOk = srParts.length === 2 && isNum(srW) && isNum(srH);
const srShort = srOk ? (srW < srH ? srW : srH) : 0;
const srLong = srOk ? (srW < srH ? srH : srW) : 0;
if (srOk && srShort <= 1) {
  add(W_SCREEN_ZERO, 'screen-zero');
} else if (srOk && (srLong > SCREEN_MAX_SIDE || srLong / srShort > SCREEN_MAX_ASPECT)) {
  // Observed: a fingerprint spoofer emitting widths of base x 3^n
  // (1236 -> 3708 -> 11124 -> ... -> 8109396) at fixed heights; 0 conversions.
  add(W_SCREEN_IMPLAUSIBLE, 'screen-implausible');
}
if (sr) {
  let suspect = false;
  lower(str(data.suspectScreens)).split(',').forEach((x) => { if (x.split(' ').join('') === sr) suspect = true; });
  if (suspect) add(W_SUSPECT_SCREEN, 'suspect-screen');
}

// Referral spam: hostname of page_referrer suffix-matched against the bundled
// traffic-seller list plus the user's extras.
const hostMatches = (host, domain) => {
  if (!domain || !host) return false;
  if (host === domain) return true;
  const suf = '.' + domain;
  return host.length > suf.length && host.substring(host.length - suf.length) === suf;
};
const refRaw = lower(str(getEventData('page_referrer')));
const refHost = refRaw ? (refRaw.indexOf('//') !== -1 ? refRaw.split('//')[1] : refRaw).split('/')[0].split(':')[0] : '';
if (refHost) {
  let spamRef = false;
  SPAM_REFERRER_DOMAINS.forEach((d) => { if (hostMatches(refHost, d)) spamRef = true; });
  lower(str(data.spamReferrers)).split(',').forEach((d) => { if (hostMatches(refHost, d.split(' ').join(''))) spamRef = true; });
  if (spamRef) add(W_SPAM_REFERRER, 'spam-referrer');
}

// "Claims to be a browser" gates.
const claimsChromium = ua.indexOf('chrome/') !== -1 || ua.indexOf('chromium/') !== -1 || ua.indexOf('edg/') !== -1;
const claimsBrowser = claimsChromium || ua.indexOf('safari') !== -1 || ua.indexOf('firefox') !== -1 || ua.indexOf('gecko/') !== -1;
const isInApp = containsAny(ua, INAPP_TOKENS);

const uaIsApple = ua.indexOf('iphone') !== -1 || ua.indexOf('ipad') !== -1 || ua.indexOf('ipod') !== -1;
const uaIsWin = ua.indexOf('windows') !== -1;
const uaIsMac = ua.indexOf('macintosh') !== -1 || ua.indexOf('mac os') !== -1;
const uaIsAndroid = ua.indexOf('android') !== -1;
const uaIsIphone = ua.indexOf('iphone') !== -1 || ua.indexOf('ipod') !== -1;
// "mobile" token only. Android TABLETS send an Android UA WITHOUT "Mobile" and
// userAgentData.mobile = false, so treating every Android UA as mobile (v3.0)
// flagged every Android tablet with a mobile mismatch.
const uaMobileTok = ua.indexOf('mobile') !== -1 || uaIsIphone;
// Android browsers in desktop-site mode (Chrome, Samsung Internet on tablets /
// DeX) send an X11/Linux UA while UA-CH can keep reporting mobile = true.
// Calibration: buyers with this UA shape sat at 30 under v3.0 (mobile mismatch
// 20 + no-client-hints 10) — real users, not forged UAs.
const uaIsLinuxDesktop = ua.indexOf('linux') !== -1 && !uaIsAndroid;

// Screen vs UA coherence. Exact screen_resolution is window.screen in CSS px.
if (srOk && srShort > 1) {
  if (uaIsIphone && srShort > IPHONE_MAX_SHORT_SIDE) add(W_SCREEN_UA_MISMATCH, 'screen-ua-mismatch');
  // Windows UA on a portrait, phone-width screen (portrait monitors are
  // >= 1080 wide). macOS is deliberately NOT checked: iOS Safari "Request
  // desktop website" sends a Macintosh UA from a real phone-sized screen.
  else if (uaIsWin && !uaMobileTok && srW < srH && srW < DESKTOP_MAX_PORTRAIT_WIDTH) add(W_SCREEN_UA_MISMATCH, 'screen-ua-mismatch');
}

// UA-CH presence. Chromium >=89 sends sec-ch-ua on HTTPS — but Android
// WebViews and many in-app browsers do NOT, and they made up ~half of real
// purchase revenue on a live retailer. So: exempt in-app/WebView, low weight.
// Safari/Firefox never send it, so this stays gated on a Chromium UA claim.
const secChUa = header('sec-ch-ua');
if (claimsChromium && !isInApp) {
  if (!secChUa) add(W_NO_CLIENT_HINTS, 'chromium-no-client-hints');
  else if (secChUa.toLowerCase().indexOf('chrom') === -1 && secChUa.toLowerCase().indexOf('brand') === -1) add(W_BRAND_MISMATCH, 'client-hint-brand-mismatch');
}

// Request-integrity headers every real engine sends on a fetch/beacon:
// accept-language, accept-encoding, and (Chromium 76+/Firefox 90+/Safari 16.4+)
// sec-fetch-mode. Scripted HTTP clients that copy only the UA miss these.
if (claimsBrowser && !header('accept-language')) add(W_NO_ACCEPT_LANG, 'no-accept-language');
if (claimsBrowser && !header('accept-encoding')) add(W_NO_ACCEPT_ENCODING, 'no-accept-encoding');
if (claimsBrowser && !header('sec-fetch-mode')) add(W_NO_SEC_FETCH, 'no-sec-fetch');

// Implausibly old Chromium major version (real fleets auto-update). Keep the
// weight LOW: real phones stuck on Chrome 61-79 cores (old Xiaomi / Sony
// browsers) also lack sec-fetch (15) and client hints (10), so at 25 they land
// on exactly 50 (seen live within a day of trying it); at 10 they stay at 35.
let uaChromeMajor = 0;
if (claimsChromium) {
  const k = ua.indexOf('chrome/') !== -1 ? 'chrome/' : (ua.indexOf('chromium/') !== -1 ? 'chromium/' : 'edg/');
  const after = ua.split(k)[1];
  if (after) {
    const major = makeNumber(after.split('.')[0]);
    if (isNum(major) && major > 0) uaChromeMajor = major;
    if (isNum(major) && major > 0 && major < CHROMIUM_MIN_MAJOR) add(W_OUTDATED_BROWSER, 'outdated-chromium');
  }
}

// ---------------------------------------------------------------------------
// client_hints (GA4 event data, populated by gtag from navigator.userAgentData).
// Richer than the sec-ch-* headers and harder to forge: a headless Chromium
// spoofing an iOS UA still populates userAgentData from the real engine, so the
// contradiction surfaces here even when every header looks plausible.
// ---------------------------------------------------------------------------
const ch = getEventData('client_hints');
const hasHints = getType(ch) === 'object';
const chPlatform = hasHints ? lower(str(ch.platform)) : '';
const chPlatformVersion = hasHints ? str(ch.platform_version) : '';

let chBrands = '';
if (hasHints && getType(ch.brands) === 'array') {
  ch.brands.forEach((b) => { if (getType(b) === 'object') chBrands = chBrands + lower(str(b.brand)) + ' '; });
}
if (hasHints && !chBrands && getType(ch.full_version_list) === 'array') {
  ch.full_version_list.forEach((b) => { if (getType(b) === 'object') chBrands = chBrands + lower(str(b.brand)) + ' '; });
}
// Chromium major as the engine itself reports it (diagnostics only for now:
// a UA whose Chrome/ major differs from this is a rewritten UA string).
let chChromiumMajor = '';
const pickChromiumMajor = (list) => {
  if (getType(list) !== 'array') return;
  list.forEach((b) => {
    if (chChromiumMajor || getType(b) !== 'object') return;
    if (lower(str(b.brand)).indexOf('chromium') === -1) return;
    const v = getType(b.version) === 'number' ? '' + b.version : str(b.version);
    chChromiumMajor = v.split('.')[0];
  });
};
if (hasHints) { pickChromiumMajor(ch.full_version_list); pickChromiumMajor(ch.brands); }

if (hasHints) {
  let contradiction = '';
  // Only Chromium emits UA-CH. As of 2026 no non-WebKit engine has shipped on
  // iOS (even under the EU DMA), so an iOS UA arriving WITH client hints is a
  // forged UA regardless of what the hints claim. Weighted 60 (not 70) so it
  // needs one corroborating signal — safe if that ever changes.
  if (uaIsApple) contradiction = 'ios-ua-with-client-hints';
  else if (chPlatform === 'ios' && !uaIsApple) contradiction = 'hint-platform-ios-ua-not';
  else if (chPlatform === 'android' && !uaIsAndroid && !uaIsLinuxDesktop) contradiction = 'hint-platform-android-ua-not';
  else if (chPlatform === 'windows' && !uaIsWin) contradiction = 'hint-platform-windows-ua-not';
  else if (chPlatform === 'macos' && !uaIsMac) contradiction = 'hint-platform-macos-ua-not';
  // Chromium brands present but the UA claims Safari-only.
  else if (chBrands.indexOf('chrom') !== -1 && !claimsChromium) contradiction = 'hint-brands-chromium-ua-safari';

  if (contradiction) add(W_HINT_CONTRADICTION, contradiction);

  // Mobile flag vs UA token — event-data version, more reliable than the header.
  if (getType(ch.mobile) === 'boolean' && !uaIsLinuxDesktop) {
    if (ch.mobile !== uaMobileTok) add(W_MOBILE_MISMATCH, 'hint-mobile-mismatch');
  }
}

// ---------------------------------------------------------------------------
// OS version plausibility. Skipped entirely for in-app browsers: they freeze
// the OS token at build time (observed on a live site: "iPhone OS 15_7_2 …
// Version/16.5 … NAVER(inapp…)" from ~26k real, paying users). A stale token
// from a WebView is not evidence of anything.
// ---------------------------------------------------------------------------
if (uaIsApple && !isInApp) {
  let seg = '';
  if (ua.indexOf('iphone os ') !== -1) seg = ua.split('iphone os ')[1];
  else if (ua.indexOf('cpu os ') !== -1) seg = ua.split('cpu os ')[1];
  if (!seg) {
    add(W_APPLE_NO_OS_TOKEN, 'apple-ua-no-os-token');
  } else {
    const iosMajor = makeNumber(seg.split('_')[0].split(' ')[0]);
    if (isNum(iosMajor) && iosMajor > 0 && (iosMajor < IOS_MIN_MAJOR || iosMajor > IOS_MAX_MAJOR)) {
      add(W_OUTDATED_IOS, 'implausible-ios-version');
    }
  }
}
// NOTE: since iOS 26 Apple freezes the UA OS token at 18_6/18_7 for privacy.
// That is >= IOS_MIN_MAJOR and never flags. iOS 16.x sits exactly at the
// floor and is a plausible surviving fleet — intended.

// Android UA shape: "Linux; Android 9; SM-G960F"
if (uaIsAndroid && !isInApp && ua.indexOf('android ') !== -1) {
  const aseg = ua.split('android ')[1];
  if (aseg) {
    const andMajor = makeNumber(aseg.split('.')[0].split(';')[0].split(' ')[0]);
    if (isNum(andMajor) && andMajor > 0 && andMajor < ANDROID_MIN_MAJOR) add(W_OUTDATED_ANDROID, 'outdated-android');
  }
}

// Cross-check the hint's own platform_version where present.
if (hasHints && chPlatformVersion && chPlatform === 'ios') {
  const chMajor = makeNumber(chPlatformVersion.split('.')[0]);
  if (isNum(chMajor) && chMajor > 0 && (chMajor < IOS_MIN_MAJOR || chMajor > IOS_MAX_MAJOR)) {
    add(W_OUTDATED_IOS, 'implausible-ios-version-hint');
  }
}

// ---------------------------------------------------------------------------
// Header-based platform / mobile coherence. Skipped when client_hints are
// present, since the event-data checks above cover the same ground and would
// otherwise double-count the same contradiction.
// ---------------------------------------------------------------------------
if (!hasHints) {
  const secPlat = lower(getRequestHeader('sec-ch-ua-platform')).split('"').join('');
  if (secPlat) {
    let mm = false;
    if (secPlat === 'windows' && !uaIsWin) mm = true;
    else if (secPlat === 'macos' && !uaIsMac) mm = true;
    else if (secPlat === 'android' && !uaIsAndroid && !uaIsLinuxDesktop) mm = true;
    else if (secPlat === 'ios' && !uaIsApple) mm = true;
    if (mm) add(W_PLATFORM_MISMATCH, 'platform-mismatch');
  }

  if (claimsChromium) {
    const secMobile = lower(getRequestHeader('sec-ch-ua-mobile'));
    if (secMobile && !uaIsLinuxDesktop) {
      if (secMobile.indexOf('?1') !== -1 && !uaMobileTok) add(W_MOBILE_MISMATCH, 'mobile-mismatch');
      else if (secMobile.indexOf('?0') !== -1 && uaMobileTok) add(W_MOBILE_MISMATCH, 'mobile-mismatch');
    }
  }
}

// Location: country from the configured header, else common auto-detected ones.
// List entries match the 2-letter country (NL) OR its continent code (EU/NA/AS/
// AF/SA/OC), resolved via the bundled CONTINENT map. "high-risk" nudges any IP;
// "out-of-market" only nudges datacenter IPs. Both are score-only and never
// hard-block — the region over-block guard.
let country = lower(getRequestHeader(str(data.geoHeader)));
if (!country) { GEO_HEADERS.forEach((h) => { if (!country) country = lower(getRequestHeader(h)); }); }
if (country && country !== 'xx' && country !== 'zz') {
  const continent = CONTINENT[country] || '';
  const geoMatch = (list) => {
    let hit = false;
    list.split(',').forEach((m) => {
      const x = m.split(' ').join('');
      if (x && (x === country || x === continent)) hit = true;
    });
    return hit;
  };
  const high = lower(str(data.highRiskRegions));
  if (high && geoMatch(high)) add(W_GEO_HIGH_RISK, 'high-risk-country');
  const inMarket = lower(str(data.inMarketRegions));
  if (inMarket && isDatacenter && !geoMatch(inMarket)) add(W_GEO_OUT_OF_MARKET, 'out-of-market-datacenter');
}

// ---------------------------------------------------------------------------
// Diagnostics: a compact fingerprint of the inputs (no IP, no full UA) to send
// as its own GA4 parameter while calibrating. Legend in NOTES.
// ---------------------------------------------------------------------------
if (outputMode === 'diagnostics') {
  const cut = (v, n) => str(v).split(' ').join('').substring(0, n);
  const sfRaw = lower(header('sec-fetch-mode'));
  const sf = !sfRaw ? '-' : (sfRaw === 'cors' ? 'c' : (sfRaw === 'no-cors' ? 'n' : (sfRaw === 'same-origin' ? 's' : (sfRaw === 'navigate' ? 'v' : 'o'))));
  let io = 'na';
  if (ipo) io = (edgeIp && ipo === edgeIp) ? 'eq' : (ipo === socketIp ? 'sk' : (edgeIp ? 'ne' : 'na'));
  const ipFam = clientIp.indexOf(':') !== -1 ? '6' : (ipInt >= 0 ? '4' : '-');
  const hm = (hasHints && getType(ch.mobile) === 'boolean') ? (ch.mobile ? '1' : '0') : '-';
  diag = ('sr=' + (cut(sr, 14) || '-')
    + ';p=' + (hasHints ? (cut(chPlatform, 3) || '_') : '-')
    + ';m=' + hm
    + ';hv=' + cut(chChromiumMajor, 3)
    + ';uv=' + (uaChromeMajor ? '' + uaChromeMajor : '')
    + ';md=' + (hasHints ? (str(ch.model) ? '1' : '0') : '-')
    + ';su=' + (secChUa ? '1' : '0')
    + ';sf=' + sf
    + ';al=' + (cut(lower(header('accept-language')).split(',')[0].split(';')[0], 5) || '-')
    + ';ul=' + (cut(lower(str(getEventData('language'))), 5) || '-')
    + ';io=' + io
    + ';if=' + ipFam
    + ';cc=' + (cut(country, 2) || '-')
    + ';ia=' + (isInApp ? '1' : '0')).substring(0, 100);
}

return finish(score, reasons);


